---
---

<section class="min-h-screen pt-20 pb-16 px-6 flex items-center bg-bg">
  <div class="max-w-7xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">

    <!-- LEFT COLUMN: Analyzer Widget -->
    <div class="analyzer-widget bg-surface border border-[#333333] rounded-none order-2 lg:order-1">
      <!-- Header bar -->
      <div class="flex items-center gap-3 px-4 py-3 bg-surfaceHigh border-b border-[#333333]">
        <div class="flex gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-accentRed block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-accentOrange block"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#2BCE4A] block"></span>
        </div>
        <span class="font-mono text-muted text-xs mx-auto">aretheycringe — analyzer</span>
      </div>

      <!-- Widget Body -->
      <div class="p-6">
        <!-- STEP 1: Platform + Handle Input -->
        <div id="step-input">
          <!-- Platform Selector -->
          <div class="flex gap-2 mb-4 flex-wrap">
            <button class="platform-btn active-platform font-display text-xs px-3 py-1 border border-muted transition-all" data-platform="INSTAGRAM">INSTAGRAM</button>
            <button class="platform-btn font-display text-xs px-3 py-1 border border-muted transition-all" data-platform="X / TWITTER">X / TWITTER</button>
            <button class="platform-btn font-display text-xs px-3 py-1 border border-muted transition-all" data-platform="TIKTOK">TIKTOK</button>
          </div>

          <!-- Handle Input Row -->
          <div class="flex">
            <input
              id="handle-input"
              type="text"
              placeholder="enter a username..."
              class="font-mono text-sm bg-bg border border-[#333333] focus:border-accent outline-none text-white px-4 py-3 flex-1 transition-colors"
            />
            <button
              id="analyze-btn"
              class="font-display bg-accent text-black px-5 py-3 rounded-none hover:brightness-110 cursor-pointer whitespace-nowrap transition-all"
            >
              ANALYZE →
            </button>
          </div>

          <!-- Profile Type Toggles -->
          <div class="flex gap-6 mt-3" id="profile-toggles">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="profile-type" value="public" checked class="sr-only" id="toggle-public" />
              <span class="custom-radio" data-for="toggle-public"></span>
              <span class="font-mono text-xs text-textSecondary">PUBLIC PROFILE</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="profile-type" value="private" class="sr-only" id="toggle-private" />
              <span class="custom-radio" data-for="toggle-private"></span>
              <span class="font-mono text-xs text-textSecondary">PRIVATE PROFILE</span>
            </label>
          </div>

          <!-- Microcopy / Private flow area -->
          <div id="profile-microcopy" class="mt-2">
            <p id="public-copy" class="font-mono text-xs text-muted">No login needed — we analyze public follow data directly.</p>
            <div id="private-flow" class="hidden">
              <div class="mt-2 p-3 border-l-[3px] border-accentRed" style="background:rgba(255,45,45,0.06)">
                <div class="flex items-start gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#FF2D2D" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  <p class="font-mono text-xs text-textSecondary">
                    Private profiles hide their follows. To analyze them, we need read access to YOUR account — so we can view their list as a mutual follower would.
                  </p>
                </div>
                <!-- Platform-specific connect buttons -->
                <div id="connect-instagram" class="connect-btn-wrap hidden mt-2">
                  <button class="w-full py-2 font-display text-white text-sm flex items-center justify-center gap-2 hover:brightness-110 transition-all" style="background:#833AB4">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    CONNECT WITH INSTAGRAM
                  </button>
                </div>
                <div id="connect-twitter" class="connect-btn-wrap hidden mt-2">
                  <button class="w-full py-2 font-display text-white text-sm flex items-center justify-center gap-2 border border-[#333] hover:bg-[#111] transition-all" style="background:#000000">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="white"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    CONNECT WITH X
                  </button>
                </div>
                <div id="connect-tiktok" class="connect-btn-wrap hidden mt-2">
                  <button class="w-full py-2 font-display text-white text-sm flex items-center justify-center gap-2 border border-[#333] hover:bg-[#1a1a1a] transition-all" style="background:#010101">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1-2.89-2.89 2.89 2.89 0 0 1 2.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 0 0-.79-.05 6.34 6.34 0 0 0-6.34 6.34 6.34 6.34 0 0 0 6.34 6.34 6.34 6.34 0 0 0 6.33-6.34V8.69a8.18 8.18 0 0 0 4.78 1.52V6.76a4.85 4.85 0 0 1-1.01-.07z"/></svg>
                    CONNECT WITH TIKTOK
                  </button>
                </div>
                <p class="font-mono text-center mt-1 text-muted" style="font-size:0.65rem">read-only access  //  we never post  //  revoke anytime</p>
              </div>
            </div>
          </div>
        </div>

        <!-- STEP 2: Scanning Progress Panel -->
        <div id="step-scanning" class="hidden">
          <div class="font-mono text-xs space-y-1 mb-4">
            <p id="scan-target" class="text-accent"></p>
            <p id="scan-platform" class="text-textSecondary"></p>
          </div>
          <p class="font-mono text-xs text-muted uppercase mb-1 tracking-wider">MAPPING FOLLOW GRAPH...</p>
          <div class="bg-surfaceHigh h-2 w-full overflow-hidden">
            <div id="progress-bar" class="h-full bg-accent transition-all duration-100" style="width:0%"></div>
          </div>
        </div>

        <!-- STEP 3: Results Panel -->
        <div id="step-results" class="hidden">
          <!-- Header row -->
          <div class="flex justify-between items-start mb-3">
            <span id="result-username" class="font-mono text-white text-sm"></span>
            <div class="text-right">
              <span id="cringe-score" class="font-display text-3xl leading-none"></span>
              <span class="font-display text-lg text-muted">/100</span>
              <p class="font-mono text-xs text-muted">CRINGE SCORE</p>
            </div>
          </div>

          <!-- Stat chips -->
          <div class="flex gap-2 mb-4 flex-wrap">
            <span id="chip-flagged" class="font-display text-xs px-2 py-0.5 bg-accentRed text-black"></span>
            <span id="chip-bots" class="font-display text-xs px-2 py-0.5 bg-accentOrange text-black"></span>
            <span id="chip-following" class="font-display text-xs px-2 py-0.5 bg-[#333] text-white"></span>
          </div>

          <!-- Flagged accounts list -->
          <div class="space-y-0 mb-4">
            <div class="flex justify-between items-center border-b border-[#222] py-1.5">
              <span class="font-mono text-xs text-textSecondary">@patriot_1776daily</span>
              <span class="font-mono text-xs px-1.5 py-0.5 bg-accentRed text-black font-medium" style="font-size:0.6rem">EXTREMIST</span>
            </div>
            <div class="flex justify-between items-center border-b border-[#222] py-1.5">
              <span class="font-mono text-xs text-textSecondary">@real_news_truth99</span>
              <span class="font-mono text-xs px-1.5 py-0.5 bg-accentOrange text-black font-medium" style="font-size:0.6rem">CONSPIRACY</span>
            </div>
            <div class="flex justify-between items-center border-b border-[#222] py-1.5">
              <span class="font-mono text-xs text-textSecondary">@proud_bois_fan</span>
              <span class="font-mono text-xs px-1.5 py-0.5 bg-accentRed text-black font-medium" style="font-size:0.6rem">HATE GROUP</span>
            </div>
            <div class="flex justify-between items-center border-b border-[#222] py-1.5">
              <span class="font-mono text-xs text-textSecondary">@f0llowback_bot</span>
              <span class="font-mono text-xs px-1.5 py-0.5 bg-accentOrange text-black font-medium" style="font-size:0.6rem">BOT</span>
            </div>
          </div>

          <!-- Bottom row -->
          <div class="flex justify-between items-center mt-4">
            <span class="font-mono text-xs text-muted">preview only — sign up for full report</span>
            <div class="flex gap-2">
              <button class="font-mono text-xs text-white border border-muted px-3 py-1 hover:border-textSecondary transition-colors">SHARE</button>
              <button
                id="join-waitlist-btn"
                class="font-display text-black bg-accent px-3 py-1 text-sm hover:brightness-110 transition-all"
              >JOIN WAITLIST ↓</button>
            </div>
          </div>

          <p class="font-mono text-xs text-muted mt-3">&gt; this is a preview scan  //  full reports available on launch</p>
          <button id="scan-another" class="font-mono text-xs text-accent mt-2 hover:underline cursor-pointer block">SCAN ANOTHER →</button>
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN: Rotating Headline + Terminal copy -->
    <div class="order-1 lg:order-2">
      <p class="font-mono text-accent text-xs mb-4 tracking-widest">[ SOCIAL GRAPH ANALYSIS ]</p>

      <h1 class="font-display text-white leading-[0.95] mb-6" style="font-size:clamp(2.8rem, 5vw, 5rem)">
        EVER WONDERED IF THEY'RE<br />
        SECRETLY A<br />
        <span id="rotating-label" class="text-accent inline-block" style="min-width:300px;transition:opacity 0.25s ease">NAZI</span>?
      </h1>

      <p class="font-body text-textSecondary text-base mb-6" style="max-width:420px">
        Social platforms, data brokers, and political operatives already profile who you follow. AreTheyCringe puts that same lens in your hands.
      </p>

      <div class="flex flex-wrap gap-4 font-mono text-xs text-muted">
        <span>✓ no login for public profiles</span>
        <span>✓ free during beta</span>
        <span>✓ read-only if private</span>
      </div>
    </div>

  </div>
</section>

<script is:inline>
  // ── Rotating Label ──────────────────────────────────────────────
  const words = [
    'NAZI',
    'PROUD BOY',
    'WHITE NATIONALIST',
    'QANON BELIEVER',
    'HOLOCAUST DENIER',
    'REPLACEMENT THEORY GUY',
    'INCEL',
    'GROYPER',
    'ACCELERATIONIST',
    'STOCHASTIC TERRORIST',
  ];
  let wordIndex = 0;
  const rotatingLabel = document.getElementById('rotating-label');

  function rotateWord() {
    rotatingLabel.style.opacity = '0';
    setTimeout(() => {
      wordIndex = (wordIndex + 1) % words.length;
      rotatingLabel.textContent = words[wordIndex];
      rotatingLabel.style.opacity = '1';
    }, 250);
  }

  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    setInterval(rotateWord, 3500);
  }

  // ── Platform Selector ───────────────────────────────────────────
  let activePlatform = 'INSTAGRAM';
  const platformBtns = document.querySelectorAll('.platform-btn');

  platformBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      platformBtns.forEach(b => b.classList.remove('active-platform'));
      btn.classList.add('active-platform');
      activePlatform = btn.dataset.platform;
      updateConnectButtons();
    });
  });

  function updateConnectButtons() {
    document.getElementById('connect-instagram').classList.add('hidden');
    document.getElementById('connect-twitter').classList.add('hidden');
    document.getElementById('connect-tiktok').classList.add('hidden');

    if (activePlatform === 'INSTAGRAM') {
      document.getElementById('connect-instagram').classList.remove('hidden');
    } else if (activePlatform === 'X / TWITTER') {
      document.getElementById('connect-twitter').classList.remove('hidden');
    } else if (activePlatform === 'TIKTOK') {
      document.getElementById('connect-tiktok').classList.remove('hidden');
    }
  }

  // ── Profile Type Toggle ─────────────────────────────────────────
  const radioPublic = document.getElementById('toggle-public');
  const radioPrivate = document.getElementById('toggle-private');
  const publicCopy = document.getElementById('public-copy');
  const privateFlow = document.getElementById('private-flow');
  const customRadios = document.querySelectorAll('.custom-radio');

  function updateRadioUI() {
    customRadios.forEach(r => {
      const targetId = r.dataset.for;
      const input = document.getElementById(targetId);
      if (input && input.checked) {
        r.classList.add('radio-checked');
      } else {
        r.classList.remove('radio-checked');
      }
    });
  }

  radioPublic.addEventListener('change', () => {
    publicCopy.classList.remove('hidden');
    privateFlow.classList.add('hidden');
    updateRadioUI();
  });

  radioPrivate.addEventListener('change', () => {
    publicCopy.classList.add('hidden');
    privateFlow.classList.remove('hidden');
    updateConnectButtons();
    updateRadioUI();
  });

  // Click on label areas
  document.querySelectorAll('[data-for]').forEach(el => {
    el.addEventListener('click', () => {
      const targetId = el.dataset.for;
      const input = document.getElementById(targetId);
      if (input) {
        input.checked = true;
        input.dispatchEvent(new Event('change'));
      }
    });
  });

  updateRadioUI();

  // ── Analyze Button ──────────────────────────────────────────────
  const analyzeBtn = document.getElementById('analyze-btn');
  const handleInput = document.getElementById('handle-input');
  const stepInput = document.getElementById('step-input');
  const stepScanning = document.getElementById('step-scanning');
  const stepResults = document.getElementById('step-results');

  analyzeBtn.addEventListener('click', () => {
    const handle = handleInput.value.trim();
    if (!handle) {
      handleInput.classList.add('shake');
      handleInput.addEventListener('animationend', () => {
        handleInput.classList.remove('shake');
      }, { once: true });
      return;
    }
    startScan(handle);
  });

  handleInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') analyzeBtn.click();
  });

  function startScan(handle) {
    // Hide input, show scanning
    stepInput.classList.add('hidden');
    stepScanning.classList.remove('hidden');
    stepResults.classList.add('hidden');

    document.getElementById('scan-target').textContent = '> target: @' + handle;
    document.getElementById('scan-platform').textContent = '> platform: ' + activePlatform;

    const progressBar = document.getElementById('progress-bar');
    progressBar.style.width = '0%';

    let start = null;
    const duration = 2500;

    function animateProgress(timestamp) {
      if (!start) start = timestamp;
      const elapsed = timestamp - start;
      const pct = Math.min((elapsed / duration) * 100, 100);
      progressBar.style.width = pct + '%';
      if (elapsed < duration) {
        requestAnimationFrame(animateProgress);
      } else {
        showResults(handle);
      }
    }

    if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
      requestAnimationFrame(animateProgress);
    } else {
      progressBar.style.width = '100%';
      showResults(handle);
    }
  }

  function randInt(min, max) {
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }

  function showResults(handle) {
    stepScanning.classList.add('hidden');
    stepResults.classList.remove('hidden');

    // Username
    document.getElementById('result-username').textContent = '@' + handle;

    // Cringe score
    const score = randInt(55, 94);
    const scoreEl = document.getElementById('cringe-score');
    scoreEl.textContent = score;
    if (score >= 70) {
      scoreEl.style.color = '#FF2D2D';
    } else if (score >= 40) {
      scoreEl.style.color = '#FF7A00';
    } else {
      scoreEl.style.color = '#E8FF00';
    }

    // Stat chips
    const flagged = randInt(3, 18);
    const bots = randInt(2, 11);
    const following = randInt(200, 1800);
    document.getElementById('chip-flagged').textContent = flagged + ' FLAGGED';
    document.getElementById('chip-bots').textContent = bots + ' BOTS';
    document.getElementById('chip-following').textContent = following + ' FOLLOWING';
  }

  // ── Join Waitlist / Scan Another ───────────────────────────────
  document.getElementById('join-waitlist-btn').addEventListener('click', () => {
    const waitlist = document.getElementById('waitlist');
    if (waitlist) waitlist.scrollIntoView({ behavior: 'smooth' });
  });

  document.getElementById('scan-another').addEventListener('click', () => {
    stepResults.classList.add('hidden');
    stepScanning.classList.add('hidden');
    stepInput.classList.remove('hidden');
    handleInput.value = '';
    // Reset radio to public
    radioPublic.checked = true;
    radioPublic.dispatchEvent(new Event('change'));
  });
</script>

<style>
  .platform-btn {
    color: #555555;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .platform-btn:hover {
    border-color: #888888;
  }
  .active-platform {
    border-color: #E8FF00 !important;
    color: #E8FF00 !important;
    background-color: rgba(232, 255, 0, 0.06) !important;
  }

  .custom-radio {
    display: inline-flex;
    width: 14px;
    height: 14px;
    border: 1.5px solid #555555;
    border-radius: 50%;
    position: relative;
    cursor: pointer;
    flex-shrink: 0;
    transition: border-color 0.15s;
  }
  .custom-radio.radio-checked {
    border-color: #E8FF00;
  }
  .custom-radio.radio-checked::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #E8FF00;
  }

  @media (prefers-reduced-motion: no-preference) {
    .shake {
      animation: shake 0.3s ease-in-out;
    }
  }
</style>
