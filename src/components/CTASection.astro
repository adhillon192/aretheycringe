---
const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT ?? '';
---

<section id="waitlist" class="py-24 px-6 bg-surface">
  <div class="max-w-xl mx-auto text-center">
    <h2 class="font-display text-white mb-4" style="font-size:clamp(2.5rem,5vw,4.5rem)">GET EARLY ACCESS.</h2>
    <p class="font-body text-textSecondary mb-8 text-base leading-relaxed max-w-[480px] mx-auto">
      We're in private beta. Drop your email and be first to find out if they're cringe.
    </p>

    <!-- Email Form -->
    <div id="waitlist-form-wrap" class="max-w-[480px] mx-auto" data-formspree-endpoint={formspreeEndpoint}>
      <form id="waitlist-form" class="flex flex-col sm:flex-row gap-0">
        <input
          id="waitlist-email"
          name="email"
          type="email"
          placeholder="your@email.com"
          class="font-mono text-sm bg-bg border border-muted focus:border-accent outline-none text-white py-3 px-4 flex-1 rounded-none transition-colors"
          required
        />
        <button
          id="waitlist-submit"
          type="submit"
          class="font-display text-black bg-accent text-lg px-6 py-3 rounded-none hover:brightness-110 whitespace-nowrap transition-all"
        >
          JOIN THE LIST
        </button>
      </form>
      <p id="email-error" class="font-mono text-xs text-accentRed mt-2 text-left hidden">&gt; invalid email address</p>
      <p id="submit-error" class="font-mono text-xs text-accentRed mt-2 text-left hidden">&gt; waitlist submission failed. try again.</p>
    </div>

    <!-- Success State -->
    <div id="waitlist-success" class="hidden font-mono text-center">
      <p class="text-accent text-sm mb-1">&gt; you're on the list.</p>
      <p class="text-accent text-sm">&gt; we'll be in touch when we launch.</p>
      <p class="text-muted text-xs mt-3">no spam. no data sold. we mean it.</p>
    </div>

    <p class="font-mono mt-4 text-center text-muted" style="font-size:0.7rem">
      &gt; no spam  //  no data sold  //  revoke anytime
    </p>

    <p class="font-body text-textSecondary text-sm mt-4 text-center">
      Join 1,200+ people already on the list.
    </p>
  </div>
</section>

<script is:inline>
  (function() {
    const waitlistForm = document.getElementById('waitlist-form');
    const emailInput = document.getElementById('waitlist-email');
    const submitBtn = document.getElementById('waitlist-submit');
    const formWrap = document.getElementById('waitlist-form-wrap');
    const successEl = document.getElementById('waitlist-success');
    const errorEl = document.getElementById('email-error');
    const submitErrorEl = document.getElementById('submit-error');
    const formspreeEndpoint = formWrap.dataset.formspreeEndpoint;

    function isValidEmail(email) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
    }

    waitlistForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput.value.trim();

      if (!isValidEmail(email)) {
        errorEl.classList.remove('hidden');
        submitErrorEl.classList.add('hidden');
        emailInput.classList.add('shake');
        emailInput.addEventListener('animationend', () => {
          emailInput.classList.remove('shake');
        }, { once: true });
        return;
      }

      if (!formspreeEndpoint) {
        submitErrorEl.classList.remove('hidden');
        return;
      }

      errorEl.classList.add('hidden');
      submitErrorEl.classList.add('hidden');
      submitBtn.setAttribute('disabled', 'true');

      try {
        const response = await fetch(formspreeEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ email })
        });

        if (!response.ok) {
          throw new Error('Formspree request failed');
        }

        waitlistForm.reset();
        formWrap.classList.add('hidden');
        successEl.classList.remove('hidden');
      } catch (_error) {
        submitErrorEl.classList.remove('hidden');
      } finally {
        submitBtn.removeAttribute('disabled');
      }
    });

    emailInput.addEventListener('input', () => {
      errorEl.classList.add('hidden');
      submitErrorEl.classList.add('hidden');
    });
  })();
</script>
